#EXTINF:-1 tvg-id="vk-114653103-456240604" tvg-name="Европа" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/1946459/aafbac09-dd20-42c3-9c8a-754c1c900a83/600x900" tvg-backdrop="https://sun9-87.userapi.com/s/v1/ig2/BEv6cQuz3CuygO5MCmrPtiUuZ_cRGSvJIe9R9dhZTUDeZ6bQAxIHkAY3J8QouhNc7t-ABlGrOrDwz5D1Zpbcvb2z.jpg?quality=95&size=1280x720" tvg-year="2012" tvg-rating="6.3" tvg-imdb="6.4" tvg-genre="фантастика, драма" tvg-description="Частная корпорация отправляет международную космическую экспедицию к шестому спутнику Юпитера. Цель полёта — высадиться на поверхность Европы, в подлёдном океане которой учёные предполагают существование жизни." tvg-trailer="https://www.youtube.com/watch?v=XhdRYk1Y8VA" group-title="Фильмы",Европа (2012)
