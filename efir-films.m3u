#EXTINF:-1 tvg-id="vk-223779047-456258530" tvg-name="Шёпот за окном" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/4483445/1b95e60e-b58a-454d-a4cb-fe1c9328c75d/600x900" tvg-backdrop="https://sun9-40.userapi.com/s/v1/ig2/k76PGlOcqY9hXl93ngbxHuovAe-PcyheagyUYaW3c5Zbbavi-oKLuwIDohw0yfrsz4fNHmQYauaPZPN1DmhisiMJ.jpg?quality=95&size=720x540" tvg-year="2026" tvg-rating="6.2" tvg-imdb="6.3" tvg-genre="триллер, драма, криминал" tvg-description="Овдовевший писатель Том Кеннеди переезжает с 8-летним сыном Джейком в небольшой город Фезербэнк. Когда мальчик внезапно исчезает, Том обращается за помощью к своему отцу-пенсионеру, бывшему детективу. Вместе они находит связь между похищением Джейка и серийным убийцей, задержанным много лет назад." tvg-trailer="https://www.youtube.com/watch?v=nqfGaAJ_Z7k" group-title="Фильмы",Шёпот за окном (2026)
