#EXTINF:-1 tvg-id="vk-114653103-456240914" tvg-name="Я иду искать 2" tvg-logo="https://image.tmdb.org/t/p/w500/tlqqwUXe4uK3hqmghtYSir1i80O.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/lE9CIX0NqKppnwopQdnabID6hZ1.jpg" tvg-year="2026" tvg-genre="ужасы, комедия" tvg-description="Пережив нападение со стороны проклятой семьи мужа, Грейс попадает на новый уровень опасной игры. Грейс узнаёт, что теперь опасность грозит её младшей сестре Фейт. Вместе сёстры противостоят 4-ём могущественным семьям, которые пытаются убить их, чтобы сохранить свои власть и богатства." tvg-trailer="https://www.youtube.com/watch?v=NMET8zWtO08" group-title="Фильмы",Я иду искать 2 (2026)
