#EXTINF:-1 tvg-id="vk-223779047-456258776" tvg-name="Единственный карманник в Нью-Йорке" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/10703959/99e24932-ee28-4af0-9df3-93b2465f0492/600x900" tvg-backdrop="https://sun9-62.userapi.com/s/v1/ig2/_tcRpo9iz3p1KqBmR5jFgwEHYEJzrZP0V-iPM8qXVyED5tK-iMcD0fd_qKWaeXQ7UG8INbfEDoh3LlT6r7HAYrAO.jpg?quality=95&size=1448x1086" tvg-year="2026" tvg-imdb="7.3" tvg-genre="триллер, драма, криминал" tvg-description="Нью-Йорк. Очередная кража опытного карманника Гарри идёт не по плану. Гарри становится целью криминального авторитета, и теперь ему необходимо вернуть одну из украденных вещей — USB-ключ для криптокошелька. Однако карманник уже сбыл ключ, и теперь он пускается в гонку со временем, чтобы спасти себя и жену, которая стала заложницей бандитов." tvg-trailer="https://www.youtube.com/watch?v=iXA7BmrBBxs" group-title="Фильмы",Единственный карманник в Нью-Йорке (2026)
