#EXTINF:-1 tvg-id="vk-223779047-456258766" tvg-name="Клэйфейс" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/10671298/f49d42da-8401-47e2-8155-f15021fd74f3/600x900" tvg-backdrop="https://sun9-47.userapi.com/s/v1/ig2/mozMC-mwgJDOviEm0NojrIdd5vdKzLu_ZgK9BMYDhj2Uia3asHO1GISRYH3ojGFrEJHGqJySTnSZtnGrCUVQo8Ch.jpg?quality=95&size=1448x1086" tvg-year="2026" tvg-rating="7.4" tvg-imdb="7.5" tvg-genre="фантастика, боевик" tvg-description="После травмы, обезобразившей его лицо, молодой актёр Мэтт Хейген соглашается пройти особое лечение. Однако научный эксперимент не даёт тех результатов, на которые рассчитывал Мэтт, и в результате его тело и кожа становятся гибкими и податливыми, как глина. Потерявший чувство личности и человечности актёр превращается в движимого жаждой мести монстра." tvg-trailer="https://www.youtube.com/watch?v=vkXGs9VkB9M" group-title="Фильмы",Клэйфейс (2026)
