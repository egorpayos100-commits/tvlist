#EXTINF:-1 tvg-id="vk-218393997-456239903" tvg-name="Ручная кладь" tvg-logo="https://image.tmdb.org/t/p/w500/tzI3kJ9NXDS5DQyIn1TsEcuHzO2.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/rhc8Mtuo3Kh8CndnlmTNMF8o9pU.jpg" tvg-year="2024" tvg-genre="триллер, боевик" tvg-description="Таинственный путешественник пытается заставить сотрудника службы безопасности аэропорта пропустить опасный предмет на рождественский рейс. Успеет ли тот его перехитрить?" tvg-trailer="https://www.youtube.com/watch?v=4YkeiPaq850" group-title="Фильмы",Ручная кладь (2024)
