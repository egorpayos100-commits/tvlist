#EXTINF:-1 tvg-id="vk-220018529-456249594" tvg-name="Идеальное Рождество для собаки" tvg-logo="https://image.tmdb.org/t/p/w500/a80Mg04hjQh4l0MRvv7RB0qc17S.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/hhQT0TySg3LXCE8BEPpfPJ5zJA2.jpg" tvg-year="2026" tvg-genre="комедия, драма" tvg-description="Когда внезапная болезнь разлучает семью Госс, преданный пес Уинстед делает всё возможное, чтобы любимые хозяева снова встретились к Рождеству." tvg-seasonal="1" group-title="Фильмы",Идеальное Рождество для собаки (2026)
