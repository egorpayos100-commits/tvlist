#EXTINF:-1 tvg-id="vk-223779047-456258835" tvg-name="Сын Сардара 2" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/9784475/54db1603-ab52-45a6-8b99-844755e16eb3/600x900" tvg-backdrop="https://sun9-6.userapi.com/s/v1/ig2/NAcEFOP22RtAgKOZ1z_HZC32TxKYl1zjCvaEh2eOytxculBp-WEM1RnpPJ2zW2PxbCOqkwv0nEyLB-OlpP1zSgMF.jpg?quality=95&size=1200x900" tvg-year="2025" tvg-genre="комедия, криминал" tvg-description="Прошли годы после того, как Джасси Сингх Рандхава уладил грандиозную семейную вражду и пережил домашний арест в Пенджабе. Когда он приезжает в Шотландию, чтобы вернуть бывшую жену, то попадает в ситуацию с заложниками и войной мафии, и оказывается на самой странной свадьбе в своей жизни." tvg-trailer="https://www.youtube.com/watch?v=HSX_KPfbP1o" group-title="Фильмы",Сын Сардара 2 (2025)
