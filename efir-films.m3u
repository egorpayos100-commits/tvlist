#EXTINF:-1 tvg-id="vk-230308922-456239415" tvg-name="Муфаса: Король Лев" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/10703959/abb41993-2468-4d7e-8b8a-f2452c580d88/600x900" tvg-year="2024" tvg-rating="7.6" tvg-imdb="6.6" tvg-genre="мультфильм, мюзикл, драма, приключения, семейный" tvg-description="Осиротевший Муфаса знакомится с наследником королевских кровей по имени Така. Вместе они отправляются в судьбоносное опасное путешествие, которое проверит их дружбу на прочность." tvg-trailer="https://www.youtube.com/watch?v=CNAh1QpdanY" group-title="Фильмы",Муфаса: Король Лев (2024)
