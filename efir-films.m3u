#EXTINF:-1 tvg-id="vk-114653103-456240632" tvg-name="Лара Крофт: Расхитительница гробниц 2 – Колыбель жизни" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/10900341/afc10ced-ea37-410a-bf95-b65241a4baa0/600x900" tvg-backdrop="https://sun9-64.userapi.com/s/v1/ig2/-iSMTf_Wmy8hY097JlpEpSpQrN65jgNX6HTuqkRFye82MGRZqTrsC4FWn0OHsjF8SDJhh-fmjrspyEJMThjeU_L_.jpg?quality=95&size=1280x720" tvg-year="2003" tvg-rating="6.6" tvg-imdb="5.5" tvg-genre="фэнтези, боевик, приключения" tvg-description="Лара противостоит злодею-интеллектуалу Чену Ло, возглавляющему триаду. Этот искусный бизнесмен и хладнокровный убийца задумал использовать Ящик Пандоры — оружие Судного дня." tvg-trailer="https://www.youtube.com/watch?v=G4bhBabn-wU" group-title="Фильмы",Лара Крофт: Расхитительница гробниц 2 – Колыбель жизни (2003)
