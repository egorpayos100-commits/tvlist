#EXTINF:-1 tvg-id="vk-183801042-456246073" tvg-name="Шпионский мост" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/1946459/ddec9c90-5b24-4ee9-84d0-042c8d82c76e/600x900" tvg-backdrop="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-ott/239697/2a000001612cc8c166948e498758cbd27ad3/1344x756" tvg-year="2015" tvg-rating="7.5" tvg-imdb="7.6" tvg-genre="триллер, драма, военный, история" tvg-description="Действие фильма происходит на фоне серии реальных исторических событий и рассказывает о бруклинском адвокате Джеймсе Доноване, который оказывается в эпицентре холодной войны, когда ЦРУ отправляет его на практически невозможное задание – договориться об освобождении захваченного в СССР американского пилота самолета-разведчика U2." tvg-trailer="https://www.youtube.com/watch?v=cuX7ajwz8sU" group-title="Фильмы",Шпионский мост (2015)
