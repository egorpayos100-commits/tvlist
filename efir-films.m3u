#EXTINF:-1 tvg-id="vk-220018529-456248828" tvg-name="Шан-Чи и Легенда Десяти Колец" tvg-logo="https://image.tmdb.org/t/p/w500/rXvU6SZOGyUzy9ZHJNlVMw0OeUR.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/r7K6Xt0RX4Mw0cAbZVw5cyb1Tux.jpg" tvg-year="2021" tvg-genre="боевик, приключения, фэнтези" tvg-description="Мастеру боевых искусств Шан-Чи предстоит противостоять призракам из собственного прошлого, по мере того как его втягивают в паутину интриг таинственной организации Десять колец." tvg-trailer="https://www.youtube.com/watch?v=MLj1nXTqc3g" group-title="Фильмы",Шан-Чи и Легенда Десяти Колец (2021)
