#EXTINF:-1 tvg-id="vk-114653103-456240216" tvg-name="Хижина в лесу" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/6201401/25517db7-2d59-43e8-877a-d0669a52b151/600x900" tvg-backdrop="https://sun9-61.userapi.com/s/v1/ig2/Ug_TtoF3vj1Y4nALmln3gcMcHRF9d61QuU8dgzDGRB-unsZRgnfkjblMJClxDrl7hv03Jn13YMAiE78DxabfbMvZ.jpg?quality=95&size=1280x720" tvg-year="2011" tvg-rating="6.7" tvg-imdb="7.0" tvg-genre="ужасы, комедия, фэнтези" tvg-description="Компания из пяти студентов отправляется на выходные в лесной домик, который недавно купил брат одного из них, — подальше от учёбы, где можно оторваться по-настоящему. Слегка поднабравшись, ребята обнаруживают дверь в подвал, где находят странную книгу и читают вслух заклинание, которое выпускает на волю полчища зомби. И это только начало невообразимых ужасов, с которыми придётся столкнуться незадачливым студентам." tvg-trailer="https://www.youtube.com/watch?v=NsIilFNNmkY" group-title="Фильмы",Хижина в лесу (2011)
