#EXTINF:-1 tvg-id="vk-218393997-456239897" tvg-name="Странная жизнь Тимоти Грина" tvg-logo="https://image.tmdb.org/t/p/w500/wqVdfNIS3Xm0dSWRrmnTWaL61kq.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/2ExC9bBiPYPsA1EP5nvsy0GfG44.jpg" tvg-year="2012" tvg-genre="фэнтези, драма, комедия, семейный" tvg-description="Одна пара потеряла последнюю надежду зачать ребенка, но однажды происходит чудо — младенец появляется на свет. Но он оказывается не тем, кем кажется на первый взгляд…" tvg-trailer="https://www.youtube.com/watch?v=uyCI1mLTcqs" group-title="Фильмы",Странная жизнь Тимоти Грина (2012)
