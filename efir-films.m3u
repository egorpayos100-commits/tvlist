#EXTINF:-1 tvg-id="vk-220018529-456249530" tvg-name="Приезжий" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/10835644/107c0cfd-2286-4046-8079-6f3b6c518bb8/600x900" tvg-backdrop="https://sun9-70.vkuserphoto.ru/s/v1/ig2/vn77LfYUmbWJ1njbbtbYyQUzweAkO2b26LHZNOAyarwwEgySP-7-kJ-2u0RS6DIM7VpE_hvdb56TKxDZw_Jgtibr.jpg?quality=95&size=1280x720" tvg-year="2026" tvg-rating="6.8" tvg-imdb="7.0" tvg-genre="комедия" tvg-description="Уединённый шотландский остров. Айла и её брат Сэнди охотятся на птиц, общаются с мифическими существами и отбиваются от чужаков. Их жизнь меняется, когда появляется Дэниел — неуклюжий чиновник, который хочет переселить их на большую землю." tvg-trailer="https://www.youtube.com/watch?v=vJ6TSvmnUEE" group-title="Фильмы",Приезжий (2026)
