#EXTINF:-1 tvg-id="vk-114653103-456239748" tvg-name="Окулус" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/1599028/6549dcce-f41d-4c15-b671-a92f86c2cdc2/600x900" tvg-backdrop="https://sun9-6.userapi.com/s/v1/ig2/dhHbOQeJJKVVDmB3ssiA8MS552H_2KPTo7KoS2OkfU7GVcCffFSD0oG-HRmeFdiIn2x9BMJCVBqiGqYbZeZ1qrvD.jpg?quality=95&size=1280x720" tvg-year="2013" tvg-rating="6.5" tvg-imdb="6.6" tvg-genre="ужасы, триллер" tvg-description="20-летний Тим выходит из лечебного учреждения, где провёл несколько лет, пытаясь вылечиться от детской травмы — отец убил мать, а после покончил с собой. Парня встречает старшая сестра Кайли, которая уверена, что на смерть родителей повлияло старое зеркало. Она уговаривает брата отправиться в отчий дом и там уничтожить зловещий предмет." tvg-trailer="https://www.youtube.com/watch?v=66RBsIsWJBQ" group-title="Фильмы",Окулус (2013)
