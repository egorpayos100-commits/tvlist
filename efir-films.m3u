#EXTINF:-1 tvg-id="vk-220018529-456249603" tvg-name="В сердце Нашвилла" tvg-logo="https://image.tmdb.org/t/p/w500/u6mstPdMeHTczaCgBazx8pQQQuW.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/psTMZj8gvsfYVfvd7FZCHH4xL6P.jpg" tvg-year="2026" tvg-genre="триллер, детектив" tvg-description="В Нэшвилле никто не видел Мисти Джонс 25 лет. Но когда она вернется на поиски племянницы, все пожалеют о ее приезде. В главной роли — Джессика Честейн." group-title="Фильмы",В сердце Нашвилла (2026)
