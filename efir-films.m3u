#EXTINF:-1 tvg-id="vk-220018529-456239983" tvg-name="Из 13 в 30" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/1629390/28d74b54-817d-43eb-9dd3-54177db43996/600x900" tvg-backdrop="https://sun9-49.userapi.com/s/v1/ig2/7mmWyNrLyENph4_mUgxcoZ6qVXwbYjSYrXVBVVGINkWWEKfjrcOdd3mtKusg10qVJST-lHHpzF8afUTGy1FZysca.jpg?quality=96&size=2048x1152" tvg-year="2004" tvg-rating="6.9" tvg-imdb="6.4" tvg-genre="фэнтези, мелодрама, комедия" tvg-description="Дженне всего 13 и она очень хочет стать большой. Видимо, её желание попадает по нужному адресу, поскольку наутро она просыпается… 30-летней красавицей." tvg-trailer="https://www.youtube.com/watch?v=_pmFp2W65Fs" group-title="Фильмы",Из 13 в 30 (2004)
