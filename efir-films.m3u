#EXTINF:-1 tvg-id="vk-114653103-456240887" tvg-name="Невероятная жизнь Уолтера Митти" tvg-logo="https://image.tmdb.org/t/p/w500/nIKlc3okrp1d0N7R7OA0r11J5rR.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/8hSjOHRY4OUEpqxszYbMdem8z9C.jpg" tvg-year="2013" tvg-genre="приключения, комедия, драма, фэнтези" tvg-description="Кто сказал, что в сердце маленького человека не могут жить великие мечты? Даже скромному и незаметному служащему хочется иногда совершить пусть безумные, но геройские поступки, поверить в свою силу и мужество. Почему всех спасать должны исключительно супермены?" tvg-trailer="https://www.youtube.com/watch?v=d3P2DkewcKI" group-title="Фильмы",Невероятная жизнь Уолтера Митти (2013)
