#EXTINF:-1 tvg-id="vk-220018529-456247222" tvg-name="Очень хорошие девочки" tvg-logo="https://image.tmdb.org/t/p/w500/6RyOyOXeFFDT4xQChtE3tdcF3qA.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/8NUTSNVeWDLZ97KBQM7IwK8HgTQ.jpg" tvg-year="2013" tvg-genre="драма" tvg-description="Две нью-йоркские девушки договариваются потерять свою девственность в первое лето после окончания школы. Но получается так, что они обе влюбляются в одного уличного артиста…" group-title="Фильмы",Очень хорошие девочки (2013)
