#EXTINF:-1 tvg-id="vk-114653103-456239787" tvg-trailer="https://www.youtube.com/watch?v=BnuKDpHXkOI" tvg-name="Спуск" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/10671298/ad3ee797-27da-4d5e-9545-d012aff42a4c/600x900" tvg-backdrop="https://sun9-70.userapi.com/s/v1/ig2/Ur5dGf9tdPddSrLp4FswRjD_zLcZAMUFnbj4D5J5kFt3TyWYCmqP6r67e_eqNKNuq9uRfEkQOrBUJZT_WN1xCaPP.jpg?quality=95&size=1280x720" tvg-year="2005" tvg-rating="6.8" tvg-imdb="7.2" tvg-genre="ужасы, триллер, приключения" tvg-description="Шесть подруг-любительниц экстремального времяпровождения решают отправиться в одну из пещер горного хребта. Неожиданно путь наверх оказывается заваленным, и девушкам необходимо найти другой выход. Проблема в том, что в темноте на них охотятся кошмарные плотоядные существа." group-title="Фильмы",Спуск (2005)
