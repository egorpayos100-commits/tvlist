#EXTINF:-1 tvg-id="vk-218393997-456239895" tvg-name="Гильдия убийц" tvg-logo="https://image.tmdb.org/t/p/w500/gjbIoKgebv8AfPtPCfM8PetXx5T.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/o5gaeGmlpcAOPVi2EoB9kDobvl6.jpg" tvg-year="2024" tvg-genre="фэнтези, боевик, приключения" tvg-description="После окончания жестоких Русалочьих войн Илиада подвергается нападению тёмных сил. Чтобы защитить город, Смерть заключает сделку с отважным бойцом Аттикусом, погибшим в последней битве." group-title="Фильмы",Гильдия убийц (2024)
