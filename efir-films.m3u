#EXTINF:-1 tvg-id="vk-114653103-456239907" tvg-name="Машинист" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/1704946/327e20cf-304c-4fa3-81cc-7ca1d3be6876/600x900" tvg-backdrop="https://sun9-15.userapi.com/s/v1/ig2/tGFKgv4myWlTUgYWyDAckaBeucqP6FlY1fGpIqB0GsuWXr723NH4jPLdLpaZUoFNljgnpc93YPoVdjnsqEF--lWx.jpg?quality=95&size=1280x720" tvg-year="2003" tvg-rating="7.6" tvg-imdb="7.6" tvg-genre="триллер, драма" tvg-description="Тревор Резник не спит уже целый год. Превратившись в живой скелет, он балансирует на грани сна и реальности. Он устал отличать пугающие видения от странных событий своей каждодневной жизни, но в последнее время они стали пересекаться самым страшным и непредсказуемым образом." tvg-trailer="https://www.youtube.com/watch?v=9uEUneZAdFE" group-title="Фильмы",Машинист (2003)
