#EXTINF:-1 tvg-id="vk-220018529-456240067" tvg-name="Сдохни, Джон Такер!" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/1599028/1a08749c-a77a-40d1-80dd-654fe7b79dde/600x900" tvg-backdrop="https://sun9-38.userapi.com/s/v1/ig2/7s081LF2TPd2d6Dh1NclvzqXmI_aeGp6Q_TTAlrqYExf5P9DyyxlVDixYuHpHoElBmFjb0foW9zSV2-wJYHXYf0M.jpg?quality=96&size=2048x1152" tvg-year="2006" tvg-rating="6.7" tvg-imdb="5.7" tvg-genre="мелодрама, комедия" tvg-description="Три бывшие подружки крутого школьного ловеласа решают ему отомстить. Для приведения жестокого плана в действие нужна приманка. Выбор падает на только что переехавшую в их школу очаровательную блондиночку…" tvg-trailer="https://www.youtube.com/watch?v=hvn8RCxGauQ" group-title="Фильмы",Сдохни, Джон Такер! (2006)
