#EXTINF:-1 tvg-id="vk-220018529-456244092" tvg-name="Шопоголик" tvg-logo="https://cdnrrviubnyuntopbez5.svc.cdn.yandex.net/get-kinopoisk-image/4303601/5fe445ce-9981-4a08-b644-904da1e781f6/600x900" tvg-backdrop="https://sun9-9.userapi.com/s/v1/ig2/PKtXBTjHZHEOMJAtx-XRbG2ENYm8bgGslgS8SPr-Z2sUKKMuKIJKRCWu0DzUS_9u8O9GDVZKxZnveo5VOmRi9sRe.jpg?quality=95&size=1280x720" tvg-year="2009" tvg-rating="6.7" tvg-imdb="5.9" tvg-genre="мелодрама, комедия" tvg-description="Молодая девушка, помешанная на шопинге и дорогой одежде, живет в состоянии войны между своим банковским лимитом и искушениями большого города. При этом по профессии она — журналист финансового издания, щедро раздающего советы по правильному управлению личным капиталом." tvg-trailer="https://www.youtube.com/watch?v=J8jl1uVD8Ao" group-title="Фильмы",Шопоголик (2009)
