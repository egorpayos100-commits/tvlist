#EXTINF:-1 tvg-id="vk-114653103-456240876" tvg-name="Мамма MIA! 2" tvg-logo="https://image.tmdb.org/t/p/w500/9dMbpcL3aow3TVjWTJmxx0NbKFl.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/gtv2H1u9eGffjxVqNfJBZuFCKxR.jpg" tvg-year="2018" tvg-genre="комедия, мелодрама" tvg-description="Сбежать на райский греческий остров, чтобы гулять по улочкам очаровательного города, наслаждаться местной кухней, танцевать до утра, кататься на яхте и влюбиться без памяти — что может быть лучше? Звучит, как идеальный план на лето… да и на всю жизнь тоже." tvg-trailer="https://www.youtube.com/watch?v=qUQtY_vXwso" group-title="Фильмы",Мамма MIA! 2 (2018)
