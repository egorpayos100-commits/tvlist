#EXTINF:-1 tvg-id="vk-220018529-456248525" tvg-name="Компаньон" tvg-logo="https://image.tmdb.org/t/p/w500/wxFGXmNmFf9Y38XQVsMIrqIom8f.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/sc1abgWNXc29wSBaerrjGBih06l.jpg" tvg-year="2025" tvg-genre="ужасы, фантастика, триллер" tvg-description="Джош приобретает себе секс-андроида Айрис. Она должна во всём слушаться своего хозяина и выполнять любые его прихоти, однако со временем начинает замечать странности в окружении и своём поведении. Вскоре Айрис узнаёт, что Джош взломал её и изменил программу, чтобы создать идеальную женщину." tvg-trailer="https://www.youtube.com/watch?v=HEHarZPYyAQ" group-title="Фильмы",Компаньон (2025)
