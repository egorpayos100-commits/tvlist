#EXTINF:-1 tvg-id="vk-213377389-456247858" tvg-name="Последователи дьявола" tvg-logo="https://image.tmdb.org/t/p/w500/2JBBc64PkC5ydOwkPpnqA8VSoS9.jpg" tvg-backdrop="https://image.tmdb.org/t/p/w780/wHAswz92wSUFsWWrNZYXIs8mhGo.jpg" tvg-year="2023" tvg-genre="ужасы" tvg-description="Три женщины в маленькой деревне скрывают мрачные секреты, в том числе нечестивый союз и таинственный ингредиент, используемый в популярной лавке с едой." group-title="Фильмы",Последователи дьявола (2023)
